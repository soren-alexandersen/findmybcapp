    "secondary": [
      "ng-sales-order-entry",
      "ng-purchase-orders",
      "ng-packing-loading",
      "ng-barcode-labels"
    ],
    "claims": [
      "Aimed at suppliers to retailers like Amazon, Lidl, Walmart, Tesco and Metro",
      "Includes configurable format conversion, so no separate converter or EDI provider is needed",
      "Technical mappings are kept separate from business parameters",
      "Ready-made EDI mappings out of the box",
      "Communicates via AS2, X400, OFTP and HTTP",
      "Tracks transmission status on the documents",
      "Supports EDIFACT, ANSI X12, XML, IDoc and text formats",
      "Handles packaging hierarchies, SSCC, GTIN, GLN, DUNS and UPC",
      "Order import and export (ORDERS) and order confirmations (ORDRSP)",
      "Order changes in both directions (ORDCHG)",
      "Despatch advice with packing structure and SSCC (DESADV)",
      "Sends and receives invoices and credit memos (INVOICE)",
      "Also RECADV, REMADV, QUOTE, PRICAT, PARTIN, IFTMIN, IFTSTA, APERAK and CONTRL",
      "Add-on module connects external logistics providers, contract manufacturers and consignment stores",
      "Works with BC Essentials and Premium"
    ],
