  "questions": [
    {
      "id": "how",
      "text": "How do you want to fix a mistake on a posted document?",
      "multi": true,
      "options": [
        {
          "label": "Edit or delete the posted record directly",
          "patterns": [
            "modify",
            "delete",
            "\\bedits?\\b",
            "edit any",
            "change (serial|payment)",
            "modifying"
          ]
        },
        {
          "label": "Reverse it with correcting entries",
          "patterns": [
            "revers",
            "reposting",
            "undo receipt",
            "reopen"
          ]
        },
        {
          "label": "Only fix descriptions, dimensions or terms",
          "patterns": [
            "dimension",
            "posting description",
            "payment terms",
            "source code",
            "comments"
          ]
        },
        {
          "label": "Doesn't matter",
          "any": true
        }
      ],
      "coverage": {
        "Edit or delete the posted record directly": 0.5,
        "Reverse it with correcting entries": 0.44,
        "Only fix descriptions, dimensions or terms": 0.31
      }
    },
    {
      "id": "what",
      "text": "What usually needs correcting?",
      "multi": true,
      "options": [
        {
          "label": "Sales and purchase documents",
          "patterns": [
            "sales",
            "purchase",
            "invoice",
            "credit memo",
            "posted documents"
          ]
        },
        {
          "label": "G/L and ledger entries",
