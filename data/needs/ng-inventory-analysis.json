  "questions": [
    {
      "id": "stale-stock",
      "text": "Is old, slow-moving or expiring stock a problem for you?",
      "help": "Pick what you want to spot.",
      "multi": true,
      "options": [
        {
          "label": "Slow-moving, dead or excess stock",
          "patterns": [
            "slow[- ]?mov",
            "dead stock",
            "obsolet",
            "stale",
            "excess",
            "overstock",
            "rotation",
            "turnover",
            "inventory turn",
            "sales drop"
          ]
        },
        {
          "label": "How long items have been in stock (aging)",
          "patterns": [
            "\\bag(e|ing)\\b",
            "days on hand",
            "days supply",
            "coverage days"
          ]
        },
        {
          "label": "Expiry dates and shelf life",
          "patterns": [
            "expir",
            "shelf life",
            "best-before"
          ]
        },
        {
          "label": "No / not sure",
          "any": true
        }
      ],
      "coverage": {
        "Slow-moving, dead or excess stock": 0.21,
        "How long items have been in stock (aging)": 0.13,
        "Expiry dates and shelf life": 0.15
      }
    },
    {
      "id": "view-where",
      "text": "Where do you want to see stock information?",
      "multi": true,
      "options": [
        {
          "label": "Right on orders and item cards",
          "patterns": [
            "factbox",
            "indicator",
            "order entry",
            "order lines",
            "order lists",
            "within (sales|documents)",
            "on (quotes|order)",
            "during sales order entry",
            "from purchase orders"
          ]
        },
        {
          "label": "Dashboards or Power BI",
          "patterns": [
            "dashboard",
            "power bi",
            "\\bkpis?\\b",
            "cockpit"
          ]
        },
        {
          "label": "Reports or Excel exports",
          "patterns": [
            "report",
            "excel"
          ]
        },
        {
          "label": "Not sure / doesn't matter",
          "any": true
        }
      ],
      "coverage": {
        "Right on orders and item cards": 0.23,
        "Dashboards or Power BI": 0.18,
        "Reports or Excel exports": 0.33
      }
    },
    {
      "id": "multi-company",
      "text": "Is your stock spread over several companies in BC?",
      "options": [
        {
          "label": "Yes, several companies",
          "patterns": [
            "(multi|multiple|other|across|group)[- ]?compan",
            "companies",
            "tenants"
          ]
        },
        {
          "label": "Not sure / doesn't matter",
          "any": true
        }
      ],
      "coverage": {
        "Yes, several companies": 0.13
      }
    },
    {
      "id": "detail",
      "text": "Do you need to see stock by bin, lot or serial number?",
      "options": [
        {
          "label": "Yes",
          "patterns": [
            "\\bbins?\\b",
            "\\blots?\\b",
            "serial",
            "batch"
          ]
        },
        {
          "label": "Not sure / doesn't matter",
          "any": true
        }
      ],
      "coverage": {
        "Yes": 0.33
      }
    },
    {
      "id": "stock-levels",
      "text": "Do you want help deciding how much to keep in stock?",
      "help": "ABC classes, safety stock, reorder points.",
      "options": [
        {
          "label": "Yes",
          "patterns": [
            "\\babc\\b",
            "safety stock",
            "replenish",
            "min(imum)? and max",
