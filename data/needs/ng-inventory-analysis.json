        {
          "label": "Not sure / doesn't matter",
          "any": true
        }
      ],
      "coverage": {
        "Yes": 0.23
      }
    },
    {
      "id": "value",
      "text": "Do you need to analyse what your stock is worth and what it cost?",
      "multi": true,
      "options": [
        {
          "label": "Stock value and costing",
          "patterns": [
            "valuation",
            "\\bvalue",
            "cost (analysis|movement|variance)",
            "costing",
            "fifo",
            "lifo",
            "gmroi"
          ]
        },
        {
          "label": "Landed costs (freight, duty)",
          "patterns": [
            "landed cost",
            "duty"
          ]
        },
        {
          "label": "Not sure / doesn't matter",
          "any": true
        }
      ],
      "coverage": {
        "Stock value and costing": 0.28,
        "Landed costs (freight, duty)": 0.03
      }
    },
    {
